# ══════════════════════════════════════════════════════════════════════════════
#  Local secrets — copy to  secrets.local.ps1  and fill in.
#  secrets.local.ps1 is gitignored. Never commit the real file.
#  start.ps1 dot-sources it, and the backend it spawns inherits these.
# ══════════════════════════════════════════════════════════════════════════════

# Assistant provider: 'gemini' (default, free AI Studio tier) or 'anthropic'
$env:ASSISTANT_PROVIDER = "gemini"

# Gemini — https://aistudio.google.com/apikey
$env:GEMINI_API_KEY = "PASTE-YOUR-KEY-HERE"

# Anthropic — only needed when ASSISTANT_PROVIDER is 'anthropic'
# $env:ANTHROPIC_API_KEY = "PASTE-YOUR-KEY-HERE"

# Flask session signing. Leave unset for a demo LAN; set for anything else.
# $env:SECRET_KEY = "a-long-random-string"
