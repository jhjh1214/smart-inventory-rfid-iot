# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
env/
.venv/

# Database (runtime data — do not commit)
backend/inventory.db

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# ESP32 compiled
*.mpy

# Secrets / local config overrides
config_local.py
secrets.local.ps1

# Real ESP32 board config — holds Wi-Fi passwords in plaintext (MicroPython has
# no keystore). Ship esp32/config.example.py instead; copy it to config.py locally.
esp32/config.py
.env

# ── Bundled assets (kept in the folder for offline/portable use, never committed) ──
# GitHub rejects files over 100 MB; docs/ and firmware/ hold multi-hundred-MB artefacts.
tools/esptoolenv/
tools/*/Scripts/
firmware/*.bin
docs/report/
docs/media/
docs/prism/
docs/ieee/
docs/uec/
docs/figures/

# Claude Code local config (machine-specific absolute paths) — travels in the zip
.claude/

# Node (optional UI check only — see tools/ui_check.mjs)
node_modules/
package-lock.json
package.json
screenshots/
